# Dependencies
node_modules/

# Build output — generated by `npm run build`, never committed.
# Lesson 07 explains why: CI rebuilds it, and stale committed build output
# is one of the classic ways a "works on my machine" bug reaches production.
dist/

# Local environment files. Real secrets NEVER go in git — see Lesson 05.
.env
.env.local

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
